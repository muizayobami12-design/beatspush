# Application
PROJECT_NAME=BeatPush
VERSION=1.0.0
API_V1_STR=/api/v1
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://beatpush:password@localhost:5432/beatpush
DATABASE_ECHO=False

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# File Storage (Cloudflare R2 or AWS S3)
STORAGE_TYPE=local  # local, s3, r2
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=beatpush-media
S3_REGION=auto
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-key

# Stripe (Payment)
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Paystack (African Payments)
PAYSTACK_SECRET_KEY=sk_test_your-key
PAYSTACK_PUBLIC_KEY=pk_test_your-key
PAYSTACK_WEBHOOK_SECRET=your-webhook-secret

# Flutterwave (African Payments)
FLUTTERWAVE_SECRET_KEY=your-key
FLUTTERWAVE_PUBLIC_KEY=your-public-key

# Email (SendGrid or SMTP)
EMAIL_ENABLED=True
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-password
EMAILS_FROM_EMAIL=noreply@beatpush.com
EMAILS_FROM_NAME=BeatPush

# Spotify API
SPOTIFY_CLIENT_ID=your-client-id
SPOTIFY_CLIENT_SECRET=your-client-secret

# YouTube API
YOUTUBE_API_KEY=your-youtube-key

# Instagram Graph API
INSTAGRAM_APP_ID=your-app-id
INSTAGRAM_APP_SECRET=your-app-secret

# Twitter API
TWITTER_API_KEY=your-api-key
TWITTER_API_SECRET=your-api-secret
TWITTER_BEARER_TOKEN=your-bearer-token

# TikTok API
TIKTOK_CLIENT_KEY=your-client-key
TIKTOK_CLIENT_SECRET=your-client-secret

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# File Upload Limits
MAX_AUDIO_FILE_SIZE_MB=200
MAX_IMAGE_FILE_SIZE_MB=10
MAX_VIDEO_FILE_SIZE_MB=500
