{
  "expo": {
    "name": "BeatPush Mobile",
    "slug": "beatpush",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "beatpush",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1f2937"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.beatpush.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "BeatPush needs camera access for profile pictures and video calls",
        "NSMicrophoneUsageDescription": "BeatPush needs microphone access for voice messages and streaming",
        "NSPhotoLibraryUsageDescription": "BeatPush needs access to your photos for uploads",
        "NSLocationWhenInUseUsageDescription": "BeatPush uses your location for location-based beat recommendations",
        "UIUserInterfaceStyle": "Dark",
        "NSBonjourServices": ["_beatpush._tcp", "_beatpush._udp"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1f2937"
      },
      "package": "com.beatpush.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "https",
            "host": "beatpush.com"
          },
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "13.4"
          },
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 21,
            "enableProguardInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#a855f7",
          "sounds": ["./assets/sounds/notification.wav"]
        }
      ],
      [
        "expo-file-system"
      ],
      [
        "expo-av"
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "beatpush-mobile"
      }
    }
  }
}
