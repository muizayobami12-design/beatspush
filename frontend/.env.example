# Backend API URL
NEXT_PUBLIC_API_URL=https://beatspush-1.onrender.com

# WebSocket URL
NEXT_PUBLIC_WS_URL=wss://beatspush-1.onrender.com/ws

# Paystack Public Key (Get from https://dashboard.paystack.com)
# Test: pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Live: pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Google Analytics ID (Optional)
NEXT_PUBLIC_GA_ID=

# Environment
NEXT_PUBLIC_ENV=development
